#!/usr/bin/env bash

set -e

echo "[+] Checking Go formatting"
if [ -n "$(gofmt -l .)" ]; then
    echo "[!] Go files are not formatted:"
    gofmt -l .
    echo "[!] Run: gofmt -w ."
    exit 1
fi

echo "[+] Running go vet"
go vet ./...

echo "[+] Running tests"
./test.sh 1>/dev/null

echo "[+] Pre-commit checks passed"